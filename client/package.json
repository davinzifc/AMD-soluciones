{
  "name": "client",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start:dev": "ng serve",
    "start": "npm run license:apply && ng serve",
    "build": "npm run license:apply && ng build",
    "build:pages": "npm run license:apply && ng build --configuration production --base-href /AMD-soluciones/",
    "license:apply": "node scripts/apply-prime-ui-license.mjs",
    "postinstall": "npm run license:apply",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:agent": "ng test --watch=false --reporters=dot",
    "lint": "ng lint"
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@angular/animations": "^22.1.0",
    "@angular/cdk": "^22.1.1",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@primeuix/themes": "^3.0.0",
    "primeng": "^22.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "22.1.0",
    "eslint": "^10.6.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.0.8"
  }
}
